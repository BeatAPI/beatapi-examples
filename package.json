{
  "name": "beatapi-examples",
  "version": "0.1.0",
  "private": true,
  "description": "Official examples for the BeatAPI async AI video API.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "check:shell": "bash -n examples/curl/*.sh",
    "check:python": "python3 -m compileall -q examples/python",
    "check:openapi": "redocly lint openapi/beatapi.yaml",
    "verify": "npm test && npm run test:python && npm run check:shell && npm run check:python && npm run check:openapi"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@redocly/cli": "2.39.0"
  }
}
